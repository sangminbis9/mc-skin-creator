{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mc-skin-creator-api",
  "account_id": "8e83629048e42855e4d5a5777c769ba4",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "vars": {
    // Free-plan multimodal analysis for detailed hair, garment and per-side accessory recognition.
    "VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    // Keep the fallback identical: de-duplication gives one retry without calling a paid-only model.
    "VISION_FALLBACK_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    // FLUX 스킨 직접 생성 feature flag — "true"가 아니면 절차적 fallback만 사용
    "IMAGE_GENERATION_ENABLED": "true",
    // 정확한 UV 배치는 서버 packer가 보장한다. direct atlas는 모델이 좌표를 어겨 사용하지 않는다.
    "IMAGE_GEN_STRATEGY": "four_view",
    // 얼굴·머리·픽셀 셰이딩 품질을 위해 Klein 9B를 사용한다.
    "IMAGE_MODEL_TIER": "quality",
    // 이 계정은 프로젝트 전용이므로 무료 10,000 Neurons/day 전체를 사용한다.
    // 각 응답의 실제 token usage를 Worker가 별도로 추적한다.
    "DAILY_BUDGET_RATIO": "1.0",
  },
  "kv_namespaces": [
    {
      "binding": "MCSKIN_KV",
      // Dedicated quota/cache namespace in the mc-skin-new Cloudflare account.
      "id": "c1372b5ed9b14ab5b3cfdb51171772c3",
      "remote": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
